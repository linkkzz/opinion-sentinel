APP_NAME=舆情智析平台
# 本地开发默认用 SQLite，零配置直接启动；生产/多人协作改为 MySQL（留空则用下方分项）。
# MySQL 用法：DATABASE_URL=  + 填写 DB_HOST/DB_USER/DB_PASSWORD/DB_NAME
DATABASE_URL=sqlite:///./opinion_sentinel.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=opinion_sentinel
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
STORAGE_ROOT=./storage
ANALYSIS_POLL_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=180
COLLECTION_POLL_SECONDS=5
COLLECTION_DEFAULT_INTERVAL_SECONDS=300
COLLECTION_BATCH_SIZE=20
# 需先在采集中心扫码登录账号后才能真实采集（微博/快手）
COLLECTION_LOGIN_HEADLESS=true
COLLECTION_LOGIN_TIMEOUT=180
COLLECTION_REQUEST_SLEEP=2
COLLECTION_COOKIE_REFRESH_INTERVAL=30
